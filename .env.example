DATABASE_URL="file:./dev.db"

# Deal
DEAL_TITLE="Two Is Better"
DEAL_ITEMS="2 Big Johns"
DEAL_PRICE_CENTS=5990

# Timings (seconds)
SYNC_TOKEN_TTL_SECONDS=60
VOUCHER_TTL_SECONDS=600

# Proximity: "twins" = phones within TWIN_MAX_DISTANCE_METERS of each other,
# anywhere (voucher goes to the nearest store). "store" = both inside a store.
PROXIMITY_MODE="twins"
# GPS can't resolve 2 m, so this is a coarse anti-relay backstop. The real
# "arm's length" check is scanning a live, rotating QR off the twin's screen.
TWIN_MAX_DISTANCE_METERS=50
QR_ROTATE_SECONDS=5
QR_MAX_AGE_SECONDS=30

# Abuse limits
MAX_DEALS_PER_DEVICE_PER_DAY=1
DAY_TIMEZONE="Africa/Johannesburg"

# Secrets – change these outside local dev
STAFF_PIN="1234"
COOKIE_SECRET="change-me-to-a-long-random-string"

# Shows the "dev mode" store picker that bypasses GPS. The server ignores
# the override unless this is "true". Never enable in production.
DEV_MODE="true"
